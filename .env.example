# GitHub Models API Token
# Get from: https://github.com/settings/tokens
# Required scopes: models
GITHUB_TOKEN=github_pat_...your_token_here...

# Critical Confidence Fields
# These fields must have "high" confidence for invoice to go to processed/
# If ANY critical field has low/medium confidence, invoice goes to needs_review/
# Separate multiple fields with commas (no spaces)
#
# Examples:
#   invoiceNumber,totalAmount,vendor
#   invoiceNumber,totalAmount,vendor,purchaseOrderNumber
#   invoiceNumber,invoiceDate,dueDate,vendor,purchaseOrderNumber,totalAmount,subtotal
#
# Leave empty to accept all invoices without confidence checks:
#   CRITICAL_CONFIDENCE_FIELDS=
#
# Default (if not set): invoiceNumber,totalAmount,vendor
CRITICAL_CONFIDENCE_FIELDS=invoiceNumber,totalAmount,vendor

# Validation Configuration (used with --validate flag)
# Only relevant when running: npm start --validate
MIN_AMOUNT=0.01
MAX_AMOUNT=10000000
TOLERANCE=1.0
